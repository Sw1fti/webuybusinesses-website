---
interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;

const navItems = [
  {
    href: '/how-it-works',
    label: 'How It Works',
    children: [
      { href: '/how-it-works#process', label: 'The Process' },
      { href: '/how-it-works#costs', label: 'What It Costs You' },
      { href: '/how-it-works#faq', label: 'FAQ' },
    ],
  },
  {
    href: '/our-deals',
    label: 'Our Deals',
    children: [
      { href: '/our-deals#examples', label: 'Examples' },
      { href: '/our-deals#structures', label: 'Structures We Use' },
      { href: '/our-deals#why-not-a-broker', label: 'Why Not a Broker?' },
    ],
  },
  {
    href: '/resources',
    label: 'Resources',
    children: [
      { href: '/resources', label: 'All Articles' },
      { href: '/sale-readiness-checklist', label: 'Sale Readiness Checklist' },
    ],
  },
];
---

<header class={`site-header ${transparent ? 'site-header--transparent' : ''}`} id="site-header">
  <div class="container site-header__inner">
    <a href="/" class="wordmark">Business Buyer</a>
    <nav class="site-nav" aria-label="Primary">
      <ul>
        {navItems.map((item) => (
          <li class="has-dropdown">
            <a href={item.href}>{item.label}</a>
            <ul class="dropdown">
              {item.children.map((child) => (
                <li><a href={child.href}>{child.label}</a></li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </nav>
    <a href="/submit" class="btn btn-primary header-cta">Submit Your Business</a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav" id="menu-toggle">
      <span class="visually-hidden">Menu</span>
      <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
        <path d="M3 7h20M3 13h20M3 19h20" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile">
    <ul>
      {navItems.map((item) => (
        <li class="mobile-nav-group">
          <a href={item.href}>{item.label}</a>
          <ul class="mobile-dropdown">
            {item.children.map((child) => (
              <li><a href={child.href}>{child.label}</a></li>
            ))}
          </ul>
        </li>
      ))}
      <li><a href="/submit" class="btn btn-primary">Submit Your Business</a></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .site-header--transparent {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: transparent;
    border-bottom-color: transparent;
  }

  .site-header--transparent .wordmark,
  .site-header--transparent .site-nav > ul > li > a,
  .site-header--transparent .menu-toggle {
    color: var(--color-ivory-text);
  }

  .site-header--transparent.is-scrolled {
    background: var(--color-bg);
    border-bottom-color: var(--color-border);
  }

  .site-header--transparent.is-scrolled .wordmark {
    color: var(--color-primary);
  }

  .site-header--transparent.is-scrolled .site-nav > ul > li > a,
  .site-header--transparent.is-scrolled .menu-toggle {
    color: var(--color-charcoal);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 10px;
    padding-bottom: 10px;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    flex-shrink: 0;
    transition: color 0.3s ease;
  }

  .site-nav > ul {
    list-style: none;
    display: flex;
    gap: 32px;
    margin: 0;
    padding: 0;
  }

  .has-dropdown {
    position: relative;
  }

  .site-nav > ul > li > a {
    display: inline-block;
    color: var(--color-charcoal);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    padding: 10px 0;
    transition: color 0.3s ease;
  }

  .site-nav > ul > li > a:hover {
    color: var(--color-primary);
  }

  .dropdown {
    position: absolute;
    top: 100%;
    left: -16px;
    min-width: 220px;
    list-style: none;
    margin: 0;
    padding: 10px 0;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    box-shadow: 0 12px 28px -12px rgba(23, 10, 12, 0.25);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s ease;
  }

  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown a {
    display: block;
    padding: 10px 20px;
    color: var(--color-charcoal);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.92rem;
    white-space: nowrap;
  }

  .dropdown a:hover {
    color: var(--color-primary);
    background: #efe7da;
  }

  .header-cta {
    flex-shrink: 0;
    padding: 8px 18px;
    font-size: 0.9rem;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--color-charcoal);
    cursor: pointer;
    padding: 4px;
    transition: color 0.3s ease;
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 860px) {
    .site-nav {
      display: none;
    }
    .header-cta {
      display: none;
    }
    .menu-toggle {
      display: block;
    }
    .mobile-nav.is-open {
      display: block;
      background: var(--color-bg);
      border-top: 1px solid var(--color-border);
      padding: 16px 24px 24px;
    }
    .mobile-nav ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .mobile-nav-group > a {
      color: var(--color-charcoal);
      text-decoration: none;
      font-weight: 600;
      font-size: 1.1rem;
    }
    .mobile-dropdown {
      list-style: none;
      margin: 10px 0 0;
      padding: 0 0 0 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      border-left: 1px solid var(--color-border);
    }
    .mobile-dropdown a {
      color: var(--color-muted);
      text-decoration: none;
      font-weight: 500;
      font-size: 0.98rem;
    }
    .mobile-nav a.btn-primary {
      color: #fff;
      text-align: center;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  const header = document.getElementById('site-header');
  if (header?.classList.contains('site-header--transparent')) {
    const onScroll = () => {
      if (window.scrollY > 60) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
