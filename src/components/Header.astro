---
import { getCollection } from 'astro:content';

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;

const articles = await getCollection('articles');
const startHere = articles.find((a) => a.data.startHere);

const submitPromo = {
  eyebrow: 'Get Started',
  title: 'Submit Your Business',
  description: 'Takes about two minutes. No obligation.',
  href: '/submit',
  linkText: 'Submit your business',
};

const navItems = [
  {
    href: '/how-it-works',
    label: 'How It Works',
    description: 'A simple, direct process — what happens at each stage, and what it costs you.',
    groupLabel: 'On This Page',
    children: [
      { href: '/how-it-works#process', label: 'The Process' },
      { href: '/how-it-works#costs', label: 'What It Costs You' },
      { href: '/how-it-works#faq', label: 'FAQ' },
    ],
    promo: submitPromo,
  },
  {
    href: '/our-deals',
    label: 'Our Deals',
    description: 'Not every business needs to be bought the same way — see how we structure them.',
    groupLabel: 'On This Page',
    children: [
      { href: '/our-deals#examples', label: 'Examples' },
      { href: '/our-deals#structures', label: 'Structures We Use' },
      { href: '/our-deals#why-not-a-broker', label: 'Why Not a Broker?' },
    ],
    promo: submitPromo,
  },
  {
    href: '/resources',
    label: 'Resources',
    description: 'Practical articles on selling, valuation, tax, succession and more.',
    groupLabel: 'Browse',
    children: [
      { href: '/resources', label: 'All Articles' },
      { href: '/sale-readiness-checklist', label: 'Sale Readiness Checklist' },
    ],
    promo: startHere
      ? {
          eyebrow: 'Start Here',
          title: startHere.data.title,
          description: startHere.data.description,
          href: `/resources/${startHere.id}`,
          linkText: 'Read the guide',
        }
      : submitPromo,
  },
];
---

<header class={`site-header ${transparent ? 'site-header--transparent' : ''}`} id="site-header">
  <div class="container site-header__inner">
    <a href="/" class="wordmark">Business Buyer</a>
    <nav class="site-nav" aria-label="Primary">
      <ul>
        {navItems.map((item) => (
          <li class="has-dropdown">
            <a href={item.href}>{item.label}</a>
            <div class="dropdown">
              <div class="container dropdown-grid">
                <div class="dropdown-intro">
                  <h3>{item.label}</h3>
                  <p>{item.description}</p>
                  <a href={item.href} class="btn btn-secondary dropdown-explore">Explore</a>
                </div>
                <div class="dropdown-links">
                  <p class="dropdown-label">{item.groupLabel}</p>
                  <ul>
                    {item.children.map((child) => (
                      <li><a href={child.href}>{child.label}</a></li>
                    ))}
                  </ul>
                </div>
                <a href={item.promo.href} class="dropdown-promo">
                  <p class="dropdown-label">{item.promo.eyebrow}</p>
                  <h4>{item.promo.title}</h4>
                  <p class="dropdown-promo-desc">{item.promo.description}</p>
                  <span class="dropdown-promo-link">{item.promo.linkText} &rarr;</span>
                </a>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </nav>
    <a href="/submit" class="btn btn-primary header-cta">Submit Your Business</a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav" id="menu-toggle">
      <span class="visually-hidden">Menu</span>
      <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
        <path d="M3 7h20M3 13h20M3 19h20" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile">
    <ul>
      {navItems.map((item) => (
        <li class="mobile-nav-group">
          <a href={item.href}>{item.label}</a>
          <ul class="mobile-dropdown">
            {item.children.map((child) => (
              <li><a href={child.href}>{child.label}</a></li>
            ))}
          </ul>
        </li>
      ))}
      <li><a href="/submit" class="btn btn-primary">Submit Your Business</a></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .site-header--transparent {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: transparent;
    border-bottom-color: transparent;
  }

  .site-header--transparent .wordmark,
  .site-header--transparent .site-nav > ul > li > a,
  .site-header--transparent .menu-toggle {
    color: var(--color-ivory-text);
  }

  .site-header--transparent.is-scrolled {
    background: var(--color-bg);
    border-bottom-color: var(--color-border);
  }

  .site-header--transparent.is-scrolled .wordmark {
    color: var(--color-primary);
  }

  .site-header--transparent.is-scrolled .site-nav > ul > li > a,
  .site-header--transparent.is-scrolled .menu-toggle {
    color: var(--color-charcoal);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 10px;
    padding-bottom: 10px;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    flex-shrink: 0;
    transition: color 0.3s ease;
  }

  .site-nav > ul {
    list-style: none;
    display: flex;
    gap: 32px;
    margin: 0;
    padding: 0;
  }

  .has-dropdown {
    position: static;
  }

  .site-nav > ul > li > a {
    display: inline-block;
    color: var(--color-charcoal);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    padding: 10px 0;
    transition: color 0.3s ease;
  }

  .site-nav > ul > li > a:hover {
    color: var(--color-primary);
  }

  .dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
    box-shadow: 0 24px 40px -24px rgba(23, 10, 12, 0.3);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease, visibility 0.15s ease;
  }

  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
  }

  .dropdown-grid {
    display: grid;
    grid-template-columns: 280px 1fr 280px;
    gap: 48px;
    padding: 48px 24px;
  }

  .dropdown-intro {
    border-right: 1px solid var(--color-border);
    padding-right: 48px;
  }

  .dropdown-intro h3 {
    font-size: 1.5rem;
    margin-bottom: 12px;
  }

  .dropdown-intro p {
    color: var(--color-muted);
    margin-bottom: 20px;
  }

  .dropdown-explore {
    padding: 10px 22px;
    font-size: 0.9rem;
  }

  .dropdown-label {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-brass);
    margin: 0 0 16px;
  }

  .dropdown-links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .dropdown-links a {
    color: var(--color-charcoal);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.98rem;
  }

  .dropdown-links a:hover {
    color: var(--color-primary);
  }

  .dropdown-promo {
    display: block;
    text-decoration: none;
    border-left: 2px solid var(--color-brass);
    padding-left: 24px;
  }

  .dropdown-promo h4 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-charcoal);
    margin: 0 0 8px;
  }

  .dropdown-promo-desc {
    color: var(--color-muted);
    font-size: 0.92rem;
    margin: 0 0 12px;
  }

  .dropdown-promo-link {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-primary);
  }

  .dropdown-promo:hover h4 {
    color: var(--color-primary);
  }

  .header-cta {
    flex-shrink: 0;
    padding: 8px 18px;
    font-size: 0.9rem;
    box-shadow: 0 2px 8px rgba(23, 10, 12, 0.18);
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--color-charcoal);
    cursor: pointer;
    padding: 4px;
    transition: color 0.3s ease;
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 1080px) {
    .dropdown-grid {
      grid-template-columns: 1fr 1fr;
    }
    .dropdown-promo {
      grid-column: 1 / -1;
      border-left: none;
      border-top: 1px solid var(--color-border);
      padding-left: 0;
      padding-top: 24px;
    }
  }

  @media (max-width: 860px) {
    .site-nav {
      display: none;
    }
    .header-cta {
      display: none;
    }
    .menu-toggle {
      display: block;
    }
    .mobile-nav.is-open {
      display: block;
      background: var(--color-bg);
      border-top: 1px solid var(--color-border);
      padding: 16px 24px 24px;
    }
    .mobile-nav ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .mobile-nav-group > a {
      color: var(--color-charcoal);
      text-decoration: none;
      font-weight: 600;
      font-size: 1.1rem;
    }
    .mobile-dropdown {
      list-style: none;
      margin: 10px 0 0;
      padding: 0 0 0 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      border-left: 1px solid var(--color-border);
    }
    .mobile-dropdown a {
      color: var(--color-muted);
      text-decoration: none;
      font-weight: 500;
      font-size: 0.98rem;
    }
    .mobile-nav a.btn-primary {
      color: #fff;
      text-align: center;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  const header = document.getElementById('site-header');
  if (header?.classList.contains('site-header--transparent')) {
    const onScroll = () => {
      if (window.scrollY > 60) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
