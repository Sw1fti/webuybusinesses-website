---
import BaseLayout from './BaseLayout.astro';
import DisclaimerNote from '../components/DisclaimerNote.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  date: Date;
}

const { title, description, category, date } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const formattedDate = date.toLocaleDateString('en-AU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: date.toISOString(),
  url: canonicalURL.toString(),
  author: {
    '@type': 'Organization',
    name: 'We Buy Businesses',
  },
  publisher: {
    '@type': 'Organization',
    name: 'We Buy Businesses',
  },
};
---

<BaseLayout title={title} description={description} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <article class="section">
    <div class="container container--narrow">
      <p class="eyebrow">{category}</p>
      <h1>{title}</h1>
      <p class="article-meta">{formattedDate}</p>

      <div class="article-body">
        <slot />
      </div>

      <DisclaimerNote />

      <div class="article-cta card">
        <h3>Thinking about selling?</h3>
        <p>We'd welcome the chance to have a confidential conversation about your business.</p>
        <a href="/submit" class="btn btn-primary">Submit Your Business</a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .container--narrow {
    max-width: 760px;
  }

  .article-meta {
    color: var(--color-muted);
    margin-bottom: 40px;
  }

  .article-body :global(h2) {
    margin-top: 2em;
  }

  .article-body :global(p) {
    font-size: 1.05rem;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    font-size: 1.05rem;
    padding-left: 1.4em;
  }

  .article-cta {
    margin-top: 48px;
    text-align: center;
  }
</style>
