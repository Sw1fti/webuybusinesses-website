---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SubmissionForm from '../components/SubmissionForm.astro';

const allArticles = await getCollection('articles');
const latestArticles = allArticles
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const sectors = [
  'Fitness',
  'Health Tech',
  'Real Estate Agencies and Rent Rolls',
  'Property – Commercial and Residential',
  'Financial Services',
  'Technology',
  'Venture Capital',
  'Funds',
  'Public Equities',
  'Infrastructure',
  'Green Energy',
];

const valuePoints = [
  {
    title: 'No broker fees',
    body: 'Deal directly with the buyer. There is no commission coming out of your sale price.',
  },
  {
    title: 'Fast movers',
    body: "We tell you within one week whether we're interested, so you're not left waiting.",
  },
  {
    title: 'Operators',
    body: "We've acquired, run and built businesses ourselves, so we understand what we're taking on.",
  },
];

const steps = [
  {
    title: 'Submit',
    body: 'Tell us about your business using our short online form. It takes a few minutes.',
  },
  {
    title: 'We review',
    body: "We look closely at your business and what you've told us, with no pressure or obligation on your part.",
  },
  {
    title: 'We respond within one week',
    body: "You'll hear back from us within a week on whether we'd like to take the conversation further.",
  },
];

const faqs = [
  {
    question: 'Do you charge any fees?',
    answer:
      "No. We're the buyer, not a broker, so there's no commission or success fee for you to pay. You may still want your own accountant or lawyer involved, which is a cost you'd have in any sale.",
  },
  {
    question: 'Is there any obligation once I submit?',
    answer:
      "None. Submitting your business starts a conversation, nothing more. If we're not a fit, we'll tell you clearly and promptly, and that's the end of it.",
  },
  {
    question: 'What happens to my information?',
    answer:
      "Your submission is reviewed by the people who'd actually be involved in a potential acquisition, not passed around widely. See our Privacy Policy for the detail.",
  },
  {
    question: 'What kind of businesses are you looking for?',
    answer:
      "Primarily Australian, asset-based businesses across the sectors listed below. For technology businesses, we also look at opportunities globally.",
  },
  {
    question: 'Do I need to prepare anything before I submit?',
    answer:
      "No — a short description is enough to start. If you'd like to gauge your own readiness first, our Sale Readiness Checklist is a useful place to begin.",
  },
];
---

<BaseLayout
  title="Home"
  description="We buy Australian businesses directly from owners — simply, quickly, and the right way. No broker fees, a response within one week."
>
  <section class="hero section">
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1>We buy businesses. Simply, quickly, and the right way.</h1>
        <p class="hero-sub">
          We're backed by private capital and business operators who look to continue operating the businesses we
          buy. If you're an Australian business owner considering a sale, we'd welcome a direct, no-pressure
          conversation.
        </p>
        <a href="/submit" class="btn btn-primary">Submit Your Business</a>
      </div>
      <div class="hero-facts">
        <div class="hero-fact">
          <p class="hero-fact-label">No broker fees</p>
        </div>
        <div class="hero-fact">
          <p class="hero-fact-label">Response within one week</p>
        </div>
        <div class="hero-fact">
          <p class="hero-fact-label">Buyers who operate, not flip</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--rule">
    <div class="container">
      <div class="value-row">
        {valuePoints.map((point, index) => (
          <div class="value-col">
            <p class="value-number">{String(index + 1).padStart(2, '0')}</p>
            <h3>{point.title}</h3>
            <p>{point.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container who-we-are-layout">
      <div class="who-we-are-label">
        <p class="eyebrow-rule">Who We Are</p>
      </div>
      <div class="who-we-are">
        <h2>Backed by capital, run by operators</h2>
        <p>
          We're backed by private capital and a group of business operators who've bought, run and grown businesses
          ourselves — not a fund looking to flip assets, and not a broker looking to collect a fee along the way.
        </p>
        <p>
          When we acquire a business, we look to continue operating it. That shapes how we evaluate every
          submission: we're thinking about the team, the customers and the day-to-day reality of the business, not
          just the numbers on a page.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow-rule">How It Works</p>
      <h2 class="with-rule">Three simple steps</h2>
      <ol class="steps-list">
        {steps.map((step, index) => (
          <li class="steps-item">
            <span class="steps-number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
      <a href="/how-it-works" class="link-more">Learn more about our process &rarr;</a>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow-rule">Our Focus</p>
      <h2 class="with-rule">Sectors We've Acquired and Built In</h2>
      <p class="sectors-intro">
        We focus on Australian asset-based businesses. For technology businesses, we're open to opportunities
        globally.
      </p>
      <ul class="sectors-list">
        {sectors.map((sector) => (
          <li>{sector}</li>
        ))}
      </ul>
    </div>
  </section>

  {latestArticles.length > 0 && (
    <section class="section">
      <div class="container">
        <p class="eyebrow-rule">Resources</p>
        <h2 class="with-rule">From our resources</h2>
        <ul class="resource-list">
          {latestArticles.map((article) => (
            <li class="resource-item">
              <a href={`/resources/${article.id}`}>
                <span class="resource-category">{article.data.category}</span>
                <h3>{article.data.title}</h3>
                <p>{article.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
        <a href="/resources" class="link-more">Browse all resources &rarr;</a>
      </div>
    </section>
  )}

  <section class="section section--alt">
    <div class="container container--narrow">
      <p class="eyebrow-rule">Common Questions</p>
      <h2 class="with-rule">Frequently asked questions</h2>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="submit">
    <div class="container">
      <p class="eyebrow-rule">Get Started</p>
      <h2 class="with-rule">Submit Your Business</h2>
      <SubmissionForm idPrefix="home" />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: 72px;
    padding-bottom: 56px;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .hero h1 {
    max-width: 640px;
  }

  .hero-sub {
    max-width: 560px;
    font-size: 1.2rem;
    color: var(--color-muted);
  }

  .hero-facts {
    border-left: 1px solid var(--color-border);
    padding-left: 32px;
    display: grid;
    gap: 24px;
    margin-top: 6px;
  }

  .hero-fact-label {
    margin: 0;
    font-weight: 700;
    font-size: 1.05rem;
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-facts {
      border-left: none;
      border-top: 1px solid var(--color-border);
      padding-left: 0;
      padding-top: 24px;
    }
  }

  .value-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .value-col {
    padding: 0 32px;
    border-left: 1px solid var(--color-border);
  }

  .value-col:first-child {
    padding-left: 0;
    border-left: none;
  }

  .value-number {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0.08em;
    margin-bottom: 12px;
  }

  @media (max-width: 900px) {
    .value-row {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .value-col {
      padding: 0;
      border-left: none;
      border-top: 1px solid var(--color-border);
      padding-top: 24px;
    }

    .value-col:first-child {
      border-top: none;
      padding-top: 0;
    }
  }

  .who-we-are-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 40px;
  }

  .who-we-are {
    max-width: 700px;
  }

  @media (max-width: 760px) {
    .who-we-are-layout {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  .steps-list {
    list-style: none;
    margin: 0 0 32px;
    padding: 0;
  }

  .steps-item {
    display: flex;
    gap: 28px;
    padding: 28px 0;
    border-top: 1px solid var(--color-border);
  }

  .steps-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .steps-number {
    flex-shrink: 0;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary);
    width: 48px;
  }

  .steps-item h3 {
    margin-bottom: 8px;
  }

  .steps-item p {
    margin: 0;
  }

  .sectors-intro {
    color: var(--color-muted);
    max-width: 640px;
  }

  .sectors-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 32px;
    padding: 0;
    margin: 32px 0 0;
  }

  .sectors-list li {
    padding: 14px 0;
    border-top: 1px solid var(--color-border);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .sectors-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .sectors-list {
      grid-template-columns: 1fr;
    }
  }

  .resource-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .resource-item {
    border-top: 1px solid var(--color-border);
    padding: 28px 0;
  }

  .resource-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .resource-item a {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .resource-category {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .resource-item h3 {
    margin: 10px 0 8px;
  }

  .resource-item:hover h3 {
    color: var(--color-primary);
  }

  .resource-item p {
    margin: 0;
    color: var(--color-muted);
  }

  .link-more {
    display: inline-block;
    margin-top: 8px;
    font-weight: 600;
    text-decoration: none;
  }

  .container--narrow {
    max-width: 760px;
  }

  .faq-list {
    margin: 0;
  }

  .faq-item {
    border-top: 1px solid var(--color-border);
    padding: 20px 0;
  }

  .faq-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-item summary {
    cursor: pointer;
    font-weight: 700;
    font-size: 1.05rem;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--color-primary);
    margin-left: 16px;
    flex-shrink: 0;
  }

  .faq-item[open] summary::after {
    content: '\2212';
  }

  .faq-item p {
    margin: 14px 0 0;
    color: var(--color-muted);
  }
</style>
