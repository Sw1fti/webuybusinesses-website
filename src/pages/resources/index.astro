---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getReadingTime } from '../../utils/reading-time';

const allArticles = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const featured = allArticles.find((a) => a.data.startHere);
const otherArticles = allArticles.filter((a) => a.id !== featured?.id);

const categories = [
  'Selling a Business',
  'Valuation',
  'Tax',
  'Succession',
  'Exit Options',
  'Legal',
];
---

<BaseLayout
  title="Resources"
  description="Practical articles on selling a business, valuation, tax, succession, exit options and legal considerations for Australian business owners."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow-rule">Resources</p>
      <h1>Articles for business owners</h1>
      <p class="lead">
        Practical, general-information articles to help you think through a sale, whenever you're ready to consider
        one.
      </p>

      {featured && (
        <a class="featured-card" href={`/resources/${featured.id}`}>
          <span class="not-ready-label">Start Here</span>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.description}</p>
          <span class="featured-meta">{getReadingTime(featured.body ?? '')} min read</span>
        </a>
      )}

      <div class="filters" role="group" aria-label="Filter by category">
        <button type="button" class="filter-btn is-active" data-filter="all">All</button>
        {categories.map((category) => (
          <button type="button" class="filter-btn" data-filter={category}>{category}</button>
        ))}
      </div>

      <ul class="article-list">
        {otherArticles.map((article) => (
          <li class="article-item" data-category={article.data.category}>
            <a href={`/resources/${article.id}`}>
              <span class="article-category">{article.data.category}</span>
              <h3>{article.data.title}</h3>
              <p>{article.data.description}</p>
              <span class="article-meta">{getReadingTime(article.body ?? '')} min read</span>
            </a>
          </li>
        ))}
      </ul>

      <p class="empty-state" id="empty-state" hidden>No articles in this category yet.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    font-size: 1.15rem;
    color: var(--color-muted);
    max-width: 640px;
  }

  .featured-card {
    display: block;
    margin: 40px 0;
    padding: 36px 0;
    border-top: 1px solid var(--color-teal-dim);
    border-bottom: 1px solid var(--color-teal-dim);
    text-decoration: none;
    color: inherit;
  }

  .not-ready-label {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-teal);
  }

  .featured-card h2 {
    margin: 12px 0 10px;
  }

  .featured-card p {
    max-width: 640px;
    margin-bottom: 10px;
  }

  .featured-card:hover h2 {
    color: var(--color-primary);
  }

  .featured-meta {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 32px 0 8px;
  }

  .filter-btn {
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-charcoal);
    cursor: pointer;
  }

  .filter-btn.is-active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }

  .article-list {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
  }

  .article-item {
    border-top: 1px solid var(--color-border);
    padding: 28px 0;
  }

  .article-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .article-item a {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .article-category {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-teal);
  }

  .article-item h3 {
    margin: 10px 0 8px;
  }

  .article-item:hover h3 {
    color: var(--color-primary);
  }

  .article-item p {
    color: var(--color-muted);
    margin-bottom: 8px;
  }

  .article-meta {
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .empty-state {
    color: var(--color-muted);
    margin-top: 32px;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLLIElement>('.article-item');
  const emptyState = document.getElementById('empty-state');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('is-active'));
      button.classList.add('is-active');

      const filter = button.dataset.filter;
      let visibleCount = 0;

      cards.forEach((card) => {
        const matches = filter === 'all' || card.dataset.category === filter;
        card.style.display = matches ? '' : 'none';
        if (matches) visibleCount += 1;
      });

      if (emptyState) {
        emptyState.hidden = visibleCount !== 0;
      }
    });
  });
</script>
