---
import BaseLayout from '../layouts/BaseLayout.astro';

const steps = [
  {
    title: 'You submit your business',
    body: "It starts with a short online form. We ask for the basics — your name, contact details, and a brief description of your business — along with some optional information that helps us respond faster, such as your industry, location, annual profit and how long you've been trading. If you have financials or a pitch deck ready, you can attach them, but it's entirely optional at this stage.",
  },
  {
    title: 'We review your submission',
    body: "Our team looks closely at what you've shared. We consider the industry, the financial profile, how the business operates, and whether it's a strong fit for us as operators. We don't outsource this review to a broker or a junior analyst — the people assessing your business are the same people who would ultimately be involved in acquiring and running it.",
  },
  {
    title: 'We respond within one week',
    body: "You'll hear back from us within one week of submitting, regardless of our decision. If we're interested, we'll reach out to talk through next steps, including a general indication of value, timeline and how a transaction might be structured. If it's not a fit for us right now, we'll let you know clearly and promptly, rather than leaving you waiting.",
  },
  {
    title: 'A direct conversation',
    body: "If there's mutual interest, we move into a more detailed conversation — understanding your business further, answering your questions about us, and working out whether the fundamentals of a deal make sense for both sides. We encourage you to involve your own accountant and lawyer from this point, and we're comfortable working alongside your advisers throughout.",
  },
  {
    title: 'Due diligence and agreement',
    body: "Once we've agreed on the broad terms, we move into due diligence — a closer look at your financials, contracts and operations — alongside drafting a formal agreement. We aim to keep this process efficient and to avoid unnecessary delays, while still being thorough enough to protect both parties.",
  },
  {
    title: 'Settlement and transition',
    body: "At settlement, ownership transfers and funds are released. We work with you on a transition period that suits your circumstances — whether that's a short handover or a longer period of involvement, depending on what works best for you, your staff, and the ongoing operation of the business.",
  },
];
---

<BaseLayout
  title="How It Works"
  description="How our process works, from submitting your business to receiving a response within one week, and why selling direct saves broker fees."
>
  <section class="section">
    <div class="container container--narrow">
      <p class="eyebrow-rule">How It Works</p>
      <h1>A simple, direct process</h1>
      <p class="lead">
        We've designed our process to be straightforward and respectful of your time. There's no obligation at any
        stage, and we never pressure owners into a decision.
      </p>

      <ol class="timeline">
        {steps.map((step, index) => (
          <li class="timeline-item">
            <span class="timeline-marker">{String(index + 1).padStart(2, '0')}</span>
            <div class="timeline-content">
              <h2>{step.title}</h2>
              <p>{step.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <h2 class="with-rule">Why selling direct saves broker fees</h2>
      <p>
        A business broker typically charges a commission of around 5% to 10% of the sale price. When you deal with
        us directly, that cost disappears — there's no broker fee coming out of what you're paid. You'll likely
        still want your own accountant and lawyer involved, but their fees are usually a small fraction of a
        broker's commission, and are generally charged at a fixed or hourly rate rather than a percentage of your
        sale price.
      </p>
      <p>
        Selling direct also tends to be faster. With fewer parties relaying information back and forth, decisions
        can be made more quickly, and you have direct visibility into where things stand at every stage.
      </p>

      <div class="cta card">
        <h3>Ready to start the conversation?</h3>
        <p>Submitting your business takes a few minutes, and you'll hear back from us within a week.</p>
        <a href="/submit" class="btn btn-primary">Submit Your Business</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container--narrow {
    max-width: 760px;
  }

  .lead {
    font-size: 1.2rem;
    color: var(--color-muted);
  }

  .timeline {
    list-style: none;
    margin: 48px 0;
    padding: 0;
  }

  .timeline-item {
    display: flex;
    gap: 28px;
    padding: 28px 0;
    border-top: 1px solid var(--color-border);
  }

  .timeline-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .timeline-marker {
    flex-shrink: 0;
    width: 48px;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .timeline-content h2 {
    font-size: 1.3rem;
    margin-bottom: 10px;
  }

  .timeline-content p {
    margin: 0;
  }

  .cta {
    margin-top: 48px;
    text-align: center;
  }
</style>
